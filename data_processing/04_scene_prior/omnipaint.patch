--- a/scripts/setup.sh
+++ b/scripts/setup.sh
@@ -2,6 +2,15 @@
 
 set -euo pipefail
 
+CONSTRAINT_FILE="/etc/pip/constraint.txt"
+
+if [[ -f "${CONSTRAINT_FILE}" ]]; then
+  sed -i 's/^h11==0\.16\.0$/h11<0.15,>=0.13/' "${CONSTRAINT_FILE}"
+  echo "Updated h11 constraint in ${CONSTRAINT_FILE}"
+else
+  echo "WARNING: ${CONSTRAINT_FILE} not found, skipping constraint update"
+fi
+
 pip install transformers==4.41.0
 pip install peft==0.10.0
 pip install gradio==5.23.0
