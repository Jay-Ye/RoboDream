# Copy to `.env` and fill in. `.env` is git-ignored and is loaded by shell/run_docker.sh.
# All paths below are HOST paths; they are mounted into the container at fixed locations
# (see shell/run_docker.sh) and exposed to the code as ROBODREAM_* variables.

# ----- Host paths -----
CKPT_DIR=/path/to/checkpoints        # -> /workspace/checkpoints  (Cosmos base, T5, RoboDream weights)
DATA_DIR=/path/to/datasets           # -> /workspace/datasets     (processed episodes, priors, T5 cache, retrieval caches)
OUTPUT_DIR=/path/to/outputs          # -> /workspace/outputs      (training logs, generated demos)
DROID_DIR=/path/to/droid             # -> /workspace/droid        (raw DROID release; only needed for data processing / retrieval)

# ----- Container -----
DOCKER_IMAGE=robodream:latest
CONTAINER_NAME=robodream

# ----- Credentials (all optional) -----
HF_TOKEN=                            # downloading gated models / uploading to the Hub
WANDB_API_KEY=                       # leave empty to disable W&B logging
WANDB_ENTITY=
WANDB_PROJECT=robodream
OPENAI_API_KEY=                      # object identification during prior extraction (data_processing/priors)
